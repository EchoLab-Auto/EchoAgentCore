[Unit]
Description=Update EchoAgentCore from its managed source checkout
Documentation=https://github.com/EchoLab-Auto/EchoAgentCore
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 作用域相关的运行身份（见 echo-agent-core.service.in 的同名占位）。
# system 作用域下这里是 User=root：updater 最后要 `systemctl restart` 一个系统级
# 单元，非 root 没这个权限，所以它必须以 root 跑（这也是 system 作用域不支持
# 非 root 服务账号的原因）。
@SCOPE_LINES@
# cargo build --release can take minutes; the systemd default start timeout
# (90s) would SIGTERM the updater mid-build and leave a stale "running" state.
TimeoutStartSec=1800
WorkingDirectory=@SOURCE_DIR@
# 显式 --local：自更新默认构建当前工作树（含未提交改动），
# 不自动 fetch 远程；需要远程更新时手动执行
#   systemctl --user start echo-agent-core-update.service -- --remote
ExecStart="@UPDATE_SCRIPT@" --local --source "@SOURCE_DIR@" --binary "@BINARY@" --status "@STATUS_FILE@"
@SCOPE_ENV@
Environment="PATH=@SERVICE_PATH@"
# 更新器只拉取并构建代码、替换用户本地二进制，从不运行 sudo；
# 保留 NoNewPrivileges 以限制被攻破的构建脚本的提权能力。
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
